{
  "name": "Phalanx",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb",
        "Dart-Code.flutter",
        "Dart-Code.dart-code",
        "tamasfe.even-better-toml",
        "serayuzgur.crates"
      ],
      "settings": {
        "rust-analyzer.check.command": "clippy",
        "rust-analyzer.check.extraArgs": ["--workspace"],
        "editor.formatOnSave": true
      }
    }
  },
  "postCreateCommand": "cargo fetch",
  "remoteUser": "root"
}
